# Hilo Energie credentials (required)
HILO_EMAIL=you@example.com
HILO_PASSWORD=your-password

# CLI device-control commands (`hilo set`, `hilo scene`, `hilo optout`, `hilo prefs`)
# need a target location id. Look it up with `hilo locations`.
# HILO_LOCATION=12345

# Override the on-disk token cache path (default: ~/.cache/hilo/tokens.json)
# HILO_TOKEN_STORE=./tokens.json

# Integration tests are gated and off by default.
# Reads only:
# HILO_INTEGRATION=1
# HILO_TEST_LOCATION_ID=12345
# Writes against a live account (use with care):
# HILO_INTEGRATION_WRITE=1
# HILO_TEST_THERMOSTAT_ID=67890
